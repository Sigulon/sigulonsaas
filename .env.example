# Sigulon SaaS — root env (Next.js control plane + workers)
# Copy to .env.local for `next dev`. See voice-runtime/.env.example for the worker.

# Data
MONGODB_URI=mongodb://localhost:27017/sigulon
REDIS_URL=redis://localhost:6379/0

# App URLs
APP_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
VOICE_RUNTIME_URL=

# Internal server-to-server auth (control plane <-> voice worker <-> campaign worker)
INTERNAL_API_SECRET=change-me
ENCRYPTION_SECRET=change-me-32-bytes-min

# LiveKit Cloud (telephony path: Plivo SIP <-> LiveKit; worker: voice-runtime/agent.py)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WEBHOOK_SECRET=wh-secret-from-dashboard
LIVEKIT_AGENT_NAME=sigulon-voice-agent

# Speech / LLM (LLM: Gemini 2.5 Flash & STT: Deepgram Nova-3 via LiveKit Inference; TTS: Cartesia direct)
CARTESIA_API_KEY=
CARTESIA_BASE_URL=https://api.cartesia.ai

# Recordings (LiveKit Egress -> GCS; webhook marks Call.recording_url)
GCS_RECORDINGS_BUCKET=sigulon-recordings-dev
RECORDINGS_CDN_URL=

# Billing
CREDITS_PER_MINUTE=1
CREDITS_MIN_MINUTES=1
CREDITS_RESERVE_MINUTES=3

# Plivo (SIP trunking only — no media webhooks; kept for trunk provisioning
# + 2-week dual-run status reconciliation, then removed)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Email (postcall owner notify)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
