# Sigulon voice-runtime (LiveKit Agents worker) — copy to .env
# Media path: Plivo SIP <-> LiveKit Cloud <-> Agents worker. No RTP here.

# LiveKit Cloud (required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WEBHOOK_SECRET=wh-secret-from-dashboard
LIVEKIT_AGENT_NAME=sigulon-voice-agent

# Speech / LLM (LLM: Gemini 2.5 Flash & STT: Deepgram Nova-3 via LiveKit Inference; TTS: Cartesia direct)
CARTESIA_API_KEY=

# LiveKit Egress uploads recordings directly to Cloudflare R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=sigulon-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Source of truth + cache
MONGODB_URI=mongodb://localhost:27017/sigulon
MONGODB_DATABASE=sigulon
REDIS_URL=redis://localhost:6379/0

# Control-plane callbacks (org-scoped, runtime-stream-auth)
INTERNAL_API_BASE_URL=http://localhost:3000
INTERNAL_API_SECRET=change-me

# Tuning
CALL_CONFIG_TTL_SECS=3600
ACTIVE_CALLS_KEY_TTL_SECS=7200
