# Cloud Run: sigulon-campaign-worker (outbound dial loop, no HTTP server).
# A polling loop, not a request handler: minScale 1 keeps it resident and
# cpu-throttling off keeps the dial/sweep cadence exact. Scale dial
# throughput with maxScale (Lua governors keep N replicas correct).
# Replace REGION/PROJECT/REPO/TAG + every VALUE before applying.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: sigulon-campaign-worker
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "1"
        autoscaling.knative.dev/maxScale: "5"
        run.googleapis.com/cpu-throttling: "false"
    spec:
      timeoutSeconds: 3600
      containers:
        - image: REGION-docker.pkg.dev/PROJECT/REPO/sigulon-worker:TAG
          resources:
            limits:
              cpu: "1"
              memory: 1Gi
          env:
            - name: MONGODB_URI
              valueFrom: { secretKeyRef: { name: sigulon-secrets, key: mongodb-uri } }
            - name: REDIS_URL
              valueFrom: { secretKeyRef: { name: sigulon-secrets, key: redis-url } }
            - name: PLIVO_AUTH_ID
              valueFrom: { secretKeyRef: { name: sigulon-secrets, key: plivo-auth-id } }
            - name: PLIVO_AUTH_TOKEN
              valueFrom: { secretKeyRef: { name: sigulon-secrets, key: plivo-auth-token } }
            - name: PUBLIC_WEB_URL
              value: https://your-web-host
            - name: WORKER_CAMPAIGN_MAX_CONCURRENT
              value: "5"
