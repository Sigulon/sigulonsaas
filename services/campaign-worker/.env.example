# Sigulon campaign worker — copy to .env
# Outbound dial path: LiveKit API (room + AgentDispatch + SIP participant).

MONGODB_URI=mongodb://localhost:27017/sigulon
REDIS_URL=redis://localhost:6379/0

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=sigulon-voice-agent

# Optional callbacks base (logging/links only; dial no longer uses webhooks)
PUBLIC_WEB_URL=http://localhost:3000
ENCRYPTION_SECRET=change-me-32-bytes-min
